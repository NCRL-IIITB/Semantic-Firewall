# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# LLM gate model (OpenRouter ID); defaults to meta-llama/llama-3.3-70b-instruct
SEMANTIC_FIREWALL_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Set to 1 to request JSON-mode decoding from the provider
SEMANTIC_FIREWALL_LLM_JSON_MODE=0

# Semantic cache
SEMANTIC_FIREWALL_CACHE_SIM_THRESHOLD=0.90
SEMANTIC_FIREWALL_CACHE_WRITEBACK=1
SEMANTIC_FIREWALL_CACHE_MAX_ENTRIES=10000
SEMANTIC_FIREWALL_ALLOWLIST_MODE=skip_llm
